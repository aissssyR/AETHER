{
  "enabled": true,
  "name": "Type-check on save",
  "description": "When a TypeScript source file changes, compile and fix any errors without changing behaviour.",
  "version": "1",
  "when": { "type": "fileEdited", "patterns": ["src/**/*.ts"] },
  "then": { "type": "askAgent", "prompt": "A source file changed. Run `npm run build`. If it reports TypeScript errors, fix them while keeping behaviour identical and respecting .kiro/steering/tech.md (no shell strings, AI failures must fall back locally)." }
}
